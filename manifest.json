{
  "manifest_version": 3,
  "name": "YCsys Antia-Ads",
  "version": "1.3.1",
  "description": "Легкий блокувальник реклами для фільмів (Uakino, Rezka...) — не чіпає YouTube, TikTok та легальні сервіси",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "32": "icons/32x32.png",
    "64": "icons/64x64.png",
    "128": "icons/128x128.png",
    "256": "icons/256x256.png",
    "512": "icons/512x512.png"
  },
  "action": {
    "default_icon": {
      "32": "icons/32x32.png"
    },
    "default_title": "Antia-Ads: Легкий блокувальник реклами для фільмів"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://youtu.be/*",
        "*://m.youtube.com/*",
        "*://*.instagram.com/*",
        "*://instagram.com/*",
        "*://*.tiktok.com/*",
        "*://tiktok.com/*",
        "*://*.facebook.com/*",
        "*://facebook.com/*",
        "*://*.twitter.com/*",
        "*://twitter.com/*",
        "*://*.x.com/*",
        "*://x.com/*",
        "*://*.twitch.tv/*",
        "*://twitch.tv/*",
        "*://*.vimeo.com/*",
        "*://vimeo.com/*",
        "*://*.netflix.com/*",
        "*://*.megogo.net/*",
        "*://*.sweet.tv/*",
        "*://*.tv.kyivstar.ua/*",
        "*://tv.kyivstar.ua/*",
        "*://*.oll.tv/*",
        "*://*.oll.media/*",
        "*://*.volia.com/*",
        "*://*.setantasports.com/*",
        "*://*.youtv.ua/*",
        "*://*.lanet.tv/*",
        "*://*.apple.com/apple-tv-plus/*",
        "*://*.tv.apple.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbomax.com/*",
        "*://*.max.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}