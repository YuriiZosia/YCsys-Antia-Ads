{
  "manifest_version": 3,
  "name": "YCsys Antia-Ads",
  "version": "1.4.0",
  "description": "Легкий блокувальник реклами для обраних сайтів із мережевим та DOM-захистом.",
  "minimum_chrome_version": "145",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.uakino.me/*",
    "*://*.uakino.best/*",
    "*://*.rezka.ag/*",
    "*://*.rezka.me/*",
    "*://*.rezka.ad/*",
    "*://*.rezka.cc/*",
    "*://*.kinogo.cc/*",
    "*://*.kinogo.biz/*",
    "*://*.uaserials.pro/*",
    "*://*.ashdi.vip/*",
    "*://*.lavakino.cc/*"
  ],
  "icons": {
    "32": "icons/32x32.png",
    "64": "icons/64x64.png",
    "128": "icons/128x128.png",
    "256": "icons/256x256.png",
    "512": "icons/512x512.png"
  },
  "action": {
    "default_icon": {
      "32": "icons/32x32.png"
    },
    "default_title": "Antia-Ads: блокувальник реклами для фільмів"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.uakino.me/*",
        "*://*.uakino.best/*",
        "*://*.rezka.ag/*",
        "*://*.rezka.me/*",
        "*://*.rezka.ad/*",
        "*://*.rezka.cc/*",
        "*://*.kinogo.cc/*",
        "*://*.kinogo.biz/*",
        "*://*.uaserials.pro/*",
        "*://*.ashdi.vip/*",
        "*://*.lavakino.cc/*"
      ],
      "js": ["page-network.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.uakino.me/*",
        "*://*.uakino.best/*",
        "*://*.rezka.ag/*",
        "*://*.rezka.me/*",
        "*://*.rezka.ad/*",
        "*://*.rezka.cc/*",
        "*://*.kinogo.cc/*",
        "*://*.kinogo.biz/*",
        "*://*.uaserials.pro/*",
        "*://*.ashdi.vip/*",
        "*://*.lavakino.cc/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
